model Vehicle {
  id                 String   @id @default(uuid())
  driverId           String
  name               String
  model              String   @default("Dhaka Tesla 3-Wheeler")
  totalCapacity      Int      @default(3)
  registrationNumber String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  driver             User     @relation("DriverVehicles", fields: [driverId], references: [id], onDelete: Cascade)
  pools              Pool[]

  @@index([driverId])
}
