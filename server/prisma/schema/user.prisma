enum UserRole {
  PASSENGER
  DRIVER
}

enum UserStatus {
  ACTIVE
  OFFLINE
}

model User {
  id           String        @id @default(uuid())
  name         String
  phone        String        @unique
  passwordHash String?
  role         UserRole      @default(PASSENGER)
  status       UserStatus    @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  vehicles     Vehicle[]     @relation("DriverVehicles")
  rideRequests RideRequest[] @relation("PassengerRides")
  pools        Pool[]        @relation("DriverPools")

  @@index([role, status])
}
